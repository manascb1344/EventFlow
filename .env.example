# Copy to .env for local development. Never commit real values.
POSTGRES_URL=postgres://postgres:postgres@localhost:5435/postgres

NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Set to true to issue demo tickets without a Stripe payment. Never enable for real charges.
DEMO_CHECKOUT=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com

UPLOADTHING_TOKEN=your-uploadthing-token

# Optional storage backend used by the seed script. Leave blank to skip.
NEXT_PUBLIC_RABATA_ACCESS_KEY=
NEXT_PUBLIC_RABATA_SECRET_KEY=
NEXT_PUBLIC_RABATA_STORAGE_BUCKET=
NEXT_PUBLIC_RABATA_STORAGE_HOST=

# Only needed when regenerating seed data.
UNSPLASH_API_KEY=your-unsplash-access-key
